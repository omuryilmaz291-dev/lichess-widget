{
  "name": "lichess-widget",
  "version": "1.0.0",
  "description": "Alt+C ile açılıp kapanan, boyutu ayarlanabilir Lichess satranç widget'ı",
  "main": "main.js",
  "author": "Lichess Widget contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.lichesswidget.app",
    "productName": "Lichess Widget",
    "files": ["main.js", "preload.js", "renderer/**/*", "assets/**/*", "package.json"],
    "directories": { "output": "release" },
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "assets/icon.ico",
      "artifactName": "LichessWidget.exe"
    }
  }
}
